    class CheckAuth,ValidateLogin,CheckStatus,CheckRole,SAMenu,AdminMenu,DriverMenu,ProgressMenu,ProgressMenu2,ProgressMenu3,ProgressMenu4,ReviewUser,DriverAction,AmbAction,BackupAction,IncAction,GPSAction,ReportType,MaintAction,AmbAdminAction,VulnAction,CheckDisp,CheckAssign,AcceptDecide,AdminDecision,DispAvail,DispMethods,DriverResp,ReportNeeded,AdminReview,AdminApprove decision
    class LoginError,PendingMsg,RejectedMsg,Logout1,Logout2,Logout3,Logout4 error
    class UserApprovedOK,UserRejectedOK,VehicleAssigned,AmbCreated,AmbUpdated,AmbViewed,AmbDeleted,BackupLogged,RestoreComplete,SettingsSaved,IncCreated,DispAssigned,AutoComplete,IncClosed,AcceptOK,DeclineOK,EnRouteOK,ArrivedOK,CompletedOK,ReportSubmitted,PanicSent,HijackSent,HistoryOK,SettingsOK,GPSStored,MaintCreated success
    class UserApproveMsg,ApproveUserFlow,DriverReassignLoop process
